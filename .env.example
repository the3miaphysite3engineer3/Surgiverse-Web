# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# All values here are dummy placeholders.
VITE_OPENROUTER=
VITE_GEMINI_API_KEY=

# Recommended: server-side AI proxy (holds the real keys, incl. SovereignEG).
# When set, AIAssistant POSTs { attemptId, messages } here with the user's
# Firebase ID token instead of calling the AI provider from the browser.
# e.g. VITE_AI_PROXY_URL=https://surgiverse-web.vercel.app/api/ai-chat
VITE_AI_PROXY_URL=

# ─── SERVER-ONLY (no VITE_ prefix — never import from src/) ──────────
# AI_PROVIDER=openrouter|sovereign  (consumed by the proxy in next-migration/)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SovereignEG: OpenAI-compatible at https://backend.sovereigneg.com/v1,
# billed in EGP. Set these in the proxy host's secret store (Vercel env),
# NOT in any VITE_ variable.
# SOVEREIGN_AI_KEY=
# SOVEREIGN_MODEL=deepseek-v4-flash
# SOVEREIGN_BASE_URL=https://backend.sovereigneg.com/v1

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=surgiverse-279e5
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: presigned-URL signer for private R2 screenshots (see worker/README.md).
# Without it, the app loads screenshot `url`s directly (public buckets only).
VITE_R2_SIGNER_URL=
# Alternative: base URL of a worker that serves R2 screenshots directly,
# e.g. https://surgvideorag-uploads.<subdomain>.workers.dev serving
# GET /screenshots/<uid>/<file>. Takes precedence over the signer.
VITE_R2_PUBLIC_BASE_URL=
