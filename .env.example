# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# All values here are dummy placeholders.
VITE_OPENROUTER=
VITE_GEMINI_API_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=surgiverse-279e5
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: presigned-URL signer for private R2 screenshots (see worker/README.md).
# Without it, the app loads screenshot `url`s directly (public buckets only).
VITE_R2_SIGNER_URL=
# Alternative: base URL of a worker that serves R2 screenshots directly,
# e.g. https://surgvideorag-uploads.<subdomain>.workers.dev serving
# GET /screenshots/<uid>/<file>. Takes precedence over the signer.
VITE_R2_PUBLIC_BASE_URL=
