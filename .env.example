# Copy to .env / .env.local and fill in real values. NEVER commit .env* (gitignored).
# All values here are dummy placeholders.

# ─── Supabase (backend: auth + database) ─────────────────────────────────────
# URL + anon key are public-by-design (safe to ship in the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-ONLY — never use a VITE_ prefix, never import from src/.
# Service role bypasses all RLS: scripts (seed:models, migrate:import) only.
# SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI access token (personal) — db push / linking. Prefer env var.
# SUPABASE_ACCESS_TOKEN=

VITE_OPENROUTER=
VITE_GEMINI_API_KEY=

# Recommended: server-side AI proxy — api/ai-chat.js (Vercel serverless).
# When set, AIAssistant POSTs { attemptId, messages, model } here with the
# user's Supabase access token instead of calling the AI provider from the
# browser. e.g. https://surgiverse-web.vercel.app/api/ai-chat
VITE_AI_PROXY_URL=

# ─── SERVER-ONLY (no VITE_ prefix — read by api/ai-chat.js at runtime) ──────
# AI_PROVIDER=sovereign|openrouter   (default: sovereign)
# SovereignEG: OpenAI-compatible at https://backend.sovereigneg.com/v1,
# billed in EGP. The ai_models catalog ids are SovereignEG ids.
# SOVEREIGN_AI_KEY=
# SOVEREIGN_MODEL=deepseek-v4-flash
# SOVEREIGN_BASE_URL=https://backend.sovereigneg.com/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Direct-call fallback for LOCAL DEV only (never enable in production —
# these would ship in the browser bundle):
# VITE_SOVEREIGN_AI_KEY=
# VITE_SOVEREIGN_MODEL=
# VITE_SOVEREIGN_BASE_URL=

# ─── Legacy Firebase (kept only for the one-time data export; the app does
#     not use Firebase at runtime anymore). Export auth:
#     Firebase console → Project settings → Service accounts → private key,
#     then: npm run migrate:export -- --key PATH\serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccount.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=surgiverse-279e5
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: presigned-URL signer for private R2 screenshots (see worker/README.md).
# Without it, the app loads screenshot `url`s directly (public buckets only).
VITE_R2_SIGNER_URL=
# Alternative: base URL of a worker that serves R2 screenshots directly,
# e.g. https://surgvideorag-uploads.<subdomain>.workers.dev serving
# GET /screenshots/<uid>/<file>. Takes precedence over the signer.
VITE_R2_PUBLIC_BASE_URL=
