# ─── PUBLIC (safe to ship to the browser) ─────────────────────────
# Firebase WEB config is a public identifier, NOT a secret — it must stay
# client-visible for Auth/Firestore to work, even in Next.js. Use the
# NEXT_PUBLIC_ prefix so it is inlined into the client bundle intentionally.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=surgiverse-279e5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# (Realtime Database is unused by the app — omit unless needed.)
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Public, unsigned upload path only:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── SERVER-ONLY (NEVER prefix with NEXT_PUBLIC_ / VITE_) ───────────
# These live only in the hosting provider's secret store / .env.local
# (gitignored) and are read exclusively inside Route Handlers / Server
# Components / Server Actions. They are never imported by client code.
FIREBASE_PROJECT_ID=surgiverse-279e5
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI + upload secrets — previously exposed as VITE_OPENROUTER /
# VITE_GEMINI_API_KEY in the client bundle. Server-only from now on.
# AI_PROVIDER selects the chat backend used by app/api/ai-chat:
#   openrouter  → OPENROUTER_API_KEY / OPENROUTER_MODEL
#   sovereign   → SOVEREIGN_AI_KEY / SOVEREIGN_MODEL (OpenAI-compatible,
#                 https://backend.sovereigneg.com/v1, billed in EGP)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SOVEREIGN_AI_KEY=
SOVEREIGN_MODEL=deepseek-v4-flash
# SOVEREIGN_BASE_URL=https://backend.sovereigneg.com/v1
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
