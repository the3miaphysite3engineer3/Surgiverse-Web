rules_version = '2';
service firebase.storage {
  // This app stores screenshots in R2/Cloudinary, not Firebase Storage,
  // so the default posture is deny-by-default. Open up explicit prefixes
  // only when you start using Firebase Storage.
  match /b/{bucket}/o {
    // Example (currently DISABLED — uncomment when needed):
    // // Per-user attempt uploads: attemptScreenshots/{uid}/{attemptId}/{file}
    // match /attemptScreenshots/{uid}/{attemptId}/{file} {
    //   allow read: if request.auth != null
    //     && (request.auth.uid == uid || firestore.get(
    //       /databases/(default)/documents/users/$(request.auth.uid)).data.role in ['TA', 'professor']);
    //   allow write: if request.auth != null && request.auth.uid == uid
    //     && request.resource.size < 8 * 1024 * 1024
    //     && request.resource.contentType.matches('image/.*');
    // }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
