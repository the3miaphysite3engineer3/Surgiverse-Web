# Copy to wrangler.toml and fill in account_id (DO NOT put secrets here —
# set them with `wrangler secret put R2_ACCESS_KEY` / R2_SECRET_KEY).
name = "surgiverse-r2-signer"
main = "r2signer.js"
compatibility_date = "2024-01-01"

[vars]
R2_ACCOUNT = "YOUR_R2_ACCOUNT_ID"
R2_BUCKET = "surgvideorag"
FIREBASE_PROJECT_ID = "surgiverse-279e5"
